{
  "version": 1,
  "description": "任务类型到 Skills 的默认映射。Sisyphus 每次 task() 委派前必须读取此文件确定 load_skills。",
  "rules": {
    "visual_engineering_must_load_frontend_ui_ux": true,
    "read_before_every_task": true
  },
  "categoryDefaults": {
    "visual-engineering": [
      "flutter-dev",
      "flutter-build-responsive-layout",
      "frontend-ui-ux"
    ],
    "ultrabrain": [
      "flutter-apply-architecture-best-practices",
      "flutter-dev"
    ],
    "deep": [
      "flutter-dev"
    ],
    "unspecified-high": [
      "flutter-dev"
    ],
    "unspecified-low": [],
    "quick": [],
    "writing": [],
    "artistry": [
      "frontend-ui-ux"
    ]
  },
  "taskOverrides": {
    "unit_test": ["dart-add-unit-test"],
    "widget_test": ["flutter-add-widget-test"],
    "widget_create": ["flutter-add-widget-preview"],
    "layout_fix": ["flutter-fix-layout-issues"],
    "runtime_debug": ["dart-fix-runtime-errors"],
    "pattern_migration": ["dart-use-pattern-matching"],
    "static_analysis": ["dart-run-static-analysis"],
    "coverage": ["dart-collect-coverage"],
    "integration_test": ["flutter-add-integration-test"],
    "library_lookup": ["context7-mcp"],
    "json_serialization": ["flutter-implement-json-serialization"]
  }
}
