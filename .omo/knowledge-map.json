{
  "version": 1,
  "description": "代码改动到文档更新的映射规则。由 /sync-knowledge 命令在 Review 阶段使用。",
  "mappings": [
    {
      "id": "core-plugin",
      "patterns": ["lib/src/core/plugin/**"],
      "docs": [
        { "path": "lib/src/core/plugin/AGENTS.md", "updateMode": "append" }
      ],
      "description": "插件系统接口或注册机制变更"
    },
    {
      "id": "core-infra",
      "patterns": ["lib/src/core/app/**", "lib/src/core/router/**"],
      "docs": [
        { "path": "lib/src/core/AGENTS.md", "updateMode": "append" }
      ],
      "description": "基础设施（路由/启动/布局/生命周期）变更"
    },
    {
      "id": "database",
      "patterns": ["lib/src/core/database/**"],
      "docs": [
        { "path": ".omo/guidelines/database.md", "updateMode": "inject" }
      ],
      "description": "数据库表结构、DAO 或查询变更"
    },
    {
      "id": "widget-pattern",
      "patterns": ["lib/src/shared/widgets/**", "lib/src/core/theme/**"],
      "docs": [
        { "path": ".omo/guidelines/widget.md", "updateMode": "inject" }
      ],
      "description": "共享组件、主题 Token 或设计模式变更"
    },
    {
      "id": "plugin-impl",
      "patterns": ["lib/src/plugins/*/**"],
      "docs": [
        { "path": "lib/src/plugins/{match_1}/AGENTS.md", "updateMode": "append" }
      ],
      "description": "插件内部功能变更"
    },
    {
      "id": "shared-layer",
      "patterns": ["lib/src/shared/**"],
      "docs": [
        { "path": "lib/src/AGENTS.md", "updateMode": "append" }
      ],
      "description": "共享层组件或架构变更"
    },
    {
      "id": "test-infra",
      "patterns": ["test/**"],
      "docs": [
        { "path": "test/AGENTS.md", "updateMode": "append" }
      ],
      "description": "测试框架、策略或约定变更"
    },
    {
      "id": "bugfix",
      "patterns": ["lib/src/**"],
      "condition": "agent_judges_fix",
      "docs": [
        { "path": ".omo/learnings/errors.md", "updateMode": "append" }
      ],
      "description": "任何 Bug 修复（errors.md 采用静默写入模式）"
    }
  ],
  "defaultBehavior": {
    "unknownPattern": "ask_and_learn",
    "missingDoc": "auto_create_with_template"
  },
  "templates": {
    "AGENTS.md": ".omo/templates/AGENTS.md.template"
  },
  "$schema": "schema/knowledge-map-schema.json"
}
